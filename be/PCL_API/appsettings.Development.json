{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=PCL;Username=pcl;Password=pcl;Include Error Detail=true"
  },
  "EvidenceStorage": {
    "Local": {
      "AllowedRootDirectories": [
        "D:\\PCL\\Evidence"
      ]
    }
  },
  "Outbox": {
    "Evidence": {
      "ModuleName": "Evidence",
      "HandlerAssemblyName": "PCL.Modules.Evidence.Application",
      "SchemaName": "evidence",
      "IntervalInSeconds": 30,
      "BatchSize": 40
    },
    "Session": {
      "ModuleName": "Session",
      "HandlerAssemblyName": "PCL.Modules.Session.Application",
      "SchemaName": "session",
      "IntervalInSeconds": 30,
      "BatchSize": 40
    },
    "TaskPlanning": {
      "ModuleName": "TaskPlanning",
      "HandlerAssemblyName": "PCL.Modules.TaskPlanning.Application",
      "SchemaName": "task_planning",
      "IntervalInSeconds": 30,
      "BatchSize": 40
    }
  },
  "Inbox": {
    "TaskPlanning": {
      "ModuleName": "TaskPlanning",
      "HandlerAssemblyName": "PCL.Modules.TaskPlanning.Presentation",
      "SchemaName": "task_planning",
      "IntervalInSeconds": 30,
      "BatchSize": 40
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
