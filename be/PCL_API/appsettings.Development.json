{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=PCL;Username=pcl;Password=pcl;Include Error Detail=true"
  },
  "Outbox": {
    "Session": {
      "ModuleName": "Session",
      "HandlerAssemblyName": "PCL.Modules.Session.Application",
      "SchemaName": "session",
      "IntervalInSeconds": 10,
      "BatchSize": 20
    },
    "TaskPlanning": {
      "ModuleName": "TaskPlanning",
      "HandlerAssemblyName": "PCL.Modules.TaskPlanning.Application",
      "SchemaName": "task_planning",
      "IntervalInSeconds": 10,
      "BatchSize": 20
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
